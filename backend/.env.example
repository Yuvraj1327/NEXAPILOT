# --- App ---
APP_NAME=NexaPilot
ENVIRONMENT=development          # development | staging | production
API_V1_PREFIX=/api/v1
DEBUG=true

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (Supabase PostgreSQL) ---
# Use Supabase's "Session pooler" (port 5432) connection string for normal use.
# Example: postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
# If you use the "Transaction pooler" (port 6543, pgbouncer transaction mode),
# set DB_USE_NULLPOOL=true below since that mode is incompatible with persistent
# SQLAlchemy connection pooling.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nexapilot
DB_USE_NULLPOOL=false
DB_ECHO=false

# --- Blockchain (Monad) ---
# "local" reads contracts/deployments/local.json (a local anvil devnet
# pinned to Monad's real chain id, used for development/testing).
# Switch to "monad_testnet" once you've deployed there (see contracts/README.md)
# — that reads contracts/deployments/monad_testnet.json instead.
BLOCKCHAIN_NETWORK=local
MONAD_RPC_URL=http://127.0.0.1:8545
MONAD_CHAIN_ID=10143
REQUIRED_CONFIRMATIONS=1
RECEIPT_WAIT_TIMEOUT_SECONDS=5

# --- Auth / JWT ---
# Generate a strong secret for real deployments, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI (Claude) ---
# Get a key at https://console.anthropic.com/ — never commit a real value.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
AI_MAX_TOKENS=4096
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_OUTPUT_RETRIES=2
