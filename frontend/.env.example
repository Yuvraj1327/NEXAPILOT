# --- Backend API ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Monad chain (must match backend's BLOCKCHAIN_NETWORK / MONAD_CHAIN_ID) ---
VITE_MONAD_CHAIN_ID=10143
VITE_MONAD_RPC_URL=http://127.0.0.1:8545
VITE_MONAD_CHAIN_NAME="Monad (local devnet)"

# --- Privy (wallet connection) ---
# Get an App ID from https://dashboard.privy.io -- required for the real
# Privy login flow. Privy's own servers aren't reachable from this build
# sandbox, so this repo also ships a dev-only injected-wallet connector
# (see src/lib/web3/wagmiConfig.ts) used automatically when this is unset.
VITE_PRIVY_APP_ID=

# --- Dev-only wallet (used only when VITE_PRIVY_APP_ID is empty) ---
# A local anvil dev account private key, for exercising the full
# connect -> sign -> submit flow against the local devnet without Privy.
# NEVER put a real private key here. Anvil's well-known default account:
VITE_DEV_WALLET_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
